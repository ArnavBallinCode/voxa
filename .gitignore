# Voxa — .gitignore

# Dependencies
node_modules/
.pnp
.pnp.*

# Build outputs
.next/
out/
build/
dist/
target/
frontend/src-tauri/target/
frontend/src-tauri/binaries/*
!frontend/src-tauri/binaries/.gitkeep

# Models & Media (Local only)
**/models/
*.wav
*.mp3
*.m4a
*.ogg
*.flac
*.mp4
*.mov

# Databases & local stores
*.db
*.sqlite
*.sqlite3
meeting_minutes.db
voxa.db

# Environment & Secrets
.env
.env.local
.env.production
.env*.local
*.pem
*.key
*.cert

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS & Editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
.cursor/

# TypeScript
*.tsbuildinfo
next-env.d.ts
